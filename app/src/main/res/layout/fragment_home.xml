            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <!-- Left: leaf icon + total impact -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_leaf"
                        android:contentDescription="Leaf"
                        app:tint="@color/color_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_impact"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.2K"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="kg waste addressed"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- Middle: bar chart illustration -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="bottom|center_horizontal">

                    <View android:layout_width="10dp" android:layout_height="18dp"
                        android:background="@color/sustainiq_mint_200" android:layout_marginEnd="4dp"/>
                    <View android:layout_width="10dp" android:layout_height="28dp"
                        android:background="@color/sustainiq_mint_300" android:layout_marginEnd="4dp"/>
                    <View android:layout_width="10dp" android:layout_height="36dp"
                        android:background="@color/sustainiq_mint_400" android:layout_marginEnd="4dp"/>
                    <View android:layout_width="10dp" android:layout_height="50dp"
                        android:background="@color/sustainiq_mint_500" android:layout_marginEnd="4dp"/>
                    <View android:layout_width="10dp" android:layout_height="42dp"
                        android:background="@color/sustainiq_mint_400"/>
                </LinearLayout>

                <!-- Right: tagline -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="end">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_leaf"
                        android:contentDescription=""
                        app:tint="@color/sustainiq_mint_300"
                        android:layout_gravity="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cleaner_communities"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="end"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
