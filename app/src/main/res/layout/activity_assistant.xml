<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        app:elevation="1dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_assistant"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="SUSTAINIQ Eco-Assistant"
            app:subtitle="Offline Civic &amp; Environmental Intelligence"
            app:titleTextColor="@color/text_primary"
            app:subtitleTextColor="@color/text_secondary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Suggestion chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:background="@color/color_surface_container_low">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_q_waste"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waste Rules"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_q_mpcb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MPCB Contacts"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_q_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report Workflow"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_q_air"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Air Pollution Tips" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Chat messages RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="16dp" />

        <!-- Voice state indicator -->
        <TextView
            android:id="@+id/tv_voice_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listening... speak now"
            android:gravity="center"
            android:textColor="@color/color_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:paddingVertical="4dp"
            android:background="@color/color_primary_container"
            android:visibility="gone" />

        <!-- Bottom Input Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/card_background">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_voice_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_mic"
                app:tint="@color/color_primary"
                app:backgroundTint="@color/color_primary_container"
                app:fabCustomSize="44dp"
                app:elevation="0dp"
                android:contentDescription="Voice Input"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_chat_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Ask or speak environmental query..."
                android:background="@drawable/bg_stat_card"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                android:maxLines="3"
                android:inputType="textCapSentences"
                android:imeOptions="actionSend" />

            <ImageView
                android:id="@+id/btn_send_message"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/color_on_primary"
                android:background="@drawable/dot_active"
                android:padding="10dp"
                android:contentDescription="Send"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
