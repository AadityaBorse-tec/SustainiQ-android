<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:paddingTop="56dp">

        <!-- Logo + brand -->
        <LinearLayout
            android:id="@+id/brand_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_sustainiq_logo"
                android:contentDescription="SUSTAINIQ logo"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUSTAINIQ"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/color_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- Welcome headline -->
        <TextView
            android:id="@+id/auth_welcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Welcome back"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/brand_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/auth_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sign in to continue building a cleaner city"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/auth_welcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Email field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_email"
            style="@style/Widget.SUSTAINIQ.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/email"
            android:layout_marginTop="36dp"
            app:layout_constraintTop_toBottomOf="@id/auth_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:text="demo@sustainiq.app" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_password"
            style="@style/Widget.SUSTAINIQ.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/password"
            android:layout_marginTop="14dp"
            app:passwordToggleEnabled="true"
            app:layout_constraintTop_toBottomOf="@id/til_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:text="demo1234" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sign In button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sign_in"
            style="@style/Widget.SUSTAINIQ.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="@string/sign_in"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/til_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Demo note -->
        <TextView
            android:id="@+id/demo_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/demo_note"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn_sign_in"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/demo_note"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Name field (for "create account" demo) -->
        <TextView
            android:id="@+id/tv_name_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Display name (optional, used in greeting)"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_name"
            style="@style/Widget.SUSTAINIQ.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/full_name"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_name_hint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:text="Aaditya" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Continue as demo -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_demo"
            style="@style/Widget.SUSTAINIQ.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="Continue as Demo User"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            app:layout_constraintTop_toBottomOf="@id/til_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
