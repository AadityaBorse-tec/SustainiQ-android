<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F9F4">

    <!-- Official splash image — fills the whole screen exactly as provided -->
    <ImageView
        android:id="@+id/img_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/img_splash_screen"
        android:scaleType="centerCrop"
        android:contentDescription="SUSTAINIQ"
        android:alpha="0" />

    <!-- Version tag at very bottom -->
    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="v1.0 · Demo Mode"
        android:textSize="11sp"
        android:textColor="#80426B53"
        android:fontFamily="sans-serif"
        android:alpha="0" />

</FrameLayout>
