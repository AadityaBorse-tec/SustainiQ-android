<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_message_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/layout_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_badge_in_progress">

        <TextView
            android:id="@+id/tv_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUSTAINIQ Bot"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_message_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello! How can I assist your sustainability efforts today?"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/tv_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:32 AM"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"
            android:layout_gravity="end"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
